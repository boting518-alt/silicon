{
  "name": "silicon-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @silicon/web",
    "build": "npm run build --workspace @silicon/web",
    "typecheck": "npm run typecheck --workspace @silicon/web",
    "api:types": "openapi-typescript packages/api-client/openapi.json -o packages/api-client/schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
