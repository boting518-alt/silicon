# Local development only. Replace sample passwords before non-local use.
SILICON_ENV=development
DATABASE_URL=postgresql+psycopg://silicon_app:local_app_only@127.0.0.1:5432/silicon
MIGRATION_DATABASE_URL=postgresql+psycopg://silicon_migrator:local_migration_only@127.0.0.1:5432/silicon
POSTGRES_PASSWORD=local_bootstrap_only
APP_DB_PASSWORD=local_app_only
MIGRATION_DB_PASSWORD=local_migration_only

# Fixed local Keycloak realm. Fictional values only; never production credentials.
OIDC_ISSUER=https://localhost:8443/realms/silicon-dev
OIDC_CLIENT_ID=silicon-web
OIDC_CLIENT_SECRET=fictional-dev-client-secret
OIDC_CA_BUNDLE=.tools/tls/localhost.crt
PUBLIC_ORIGIN=https://localhost:5173
